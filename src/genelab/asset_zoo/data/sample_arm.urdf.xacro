<?xml version="1.0"?>
<!--
  Two-DoF arm used as the bundled sample for ``ArticulationCfg.urdf_path`` +
  ``xacro_args``. Tuned to be small enough to read end-to-end, but exercises every
  feature S5.2 wired up:

    * xacro:property — derives child sizes from a single ``link_length`` parameter
    * xacro:arg — receives the parameter through ``ArticulationCfg.xacro_args``
    * arithmetic — ``${L * 0.6}`` proves Genesis's xacro preprocessor really did run

  Genesis 1.0's ``gs.morphs.URDF`` invokes the ``xacro`` Python package on this file at
  load time and feeds the resulting plain URDF into the rigid-body builder.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sample_arm">

  <xacro:arg name="link_length" default="0.3"/>
  <xacro:property name="L" value="$(arg link_length)"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.1 0.1 0.05"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.1 0.1 0.05"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="upper_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="2.5"/>
    <origin xyz="0 0 0.025"/>
  </joint>

  <link name="upper_link">
    <inertial>
      <origin xyz="0 0 ${L / 2}"/>
      <mass value="0.5"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.04 0.04 ${L}"/></geometry>
      <origin xyz="0 0 ${L / 2}"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 ${L}"/></geometry>
      <origin xyz="0 0 ${L / 2}"/>
    </collision>
  </link>

  <joint name="elbow_pitch" type="revolute">
    <parent link="upper_link"/>
    <child link="forearm"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.5"/>
    <origin xyz="0 0 ${L}"/>
  </joint>

  <link name="forearm">
    <inertial>
      <origin xyz="0 0 ${L * 0.3}"/>
      <mass value="0.3"/>
      <inertia ixx="0.003" iyy="0.003" izz="0.003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.03 0.03 ${L * 0.6}"/></geometry>
      <origin xyz="0 0 ${L * 0.3}"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.03 ${L * 0.6}"/></geometry>
      <origin xyz="0 0 ${L * 0.3}"/>
    </collision>
  </link>

</robot>
